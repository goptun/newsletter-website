# Banco de dados
DB_PATH=data/newsletter.db

# LLM (9Router — já rodando na VPS, ver rag-knowledge-assistant/.env.example
# pro mesmo padrão). Consulte o dashboard do 9Router (aba "Combo & Vision
# Adapter") pro LLM_MODEL exato do seu combo.
LLM_BASE_URL=http://<TAILSCALE_9ROUTER_IP>:20128/v1
LLM_API_KEY=
LLM_MODEL=
# Combo de produção (@cf/openai/gpt-oss-120b) é um modelo de raciocínio —
# reserve bastante margem acima do que o texto final precisaria; medido em
# produção, só o "raciocínio" da Curiosidade do dia já usa ~1750 tokens.
GENERATION_MAX_TOKENS=4096
GENERATION_TEMPERATURE=0.4

# Notícias
NEWS_MAX_ITEMS=6

# Envio (Resend — ver design.md Decisions: "Delivery: Resend API")
RESEND_API_KEY=
NEWSLETTER_FROM_ADDRESS=newsletter@matheusramos.dev

# Notificação de "draft pronto para revisão" (ver tasks.md 5.6)
NEWSLETTER_OWNER_EMAIL=
REVIEW_BASE_URL=http://127.0.0.1:8001

# Revisão/aprovação do draft — gere um valor aleatório longo, ex.:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
REVIEW_SECRET_TOKEN=

# Swagger UI/OpenAPI em /docs e /openapi.json (só pra desenvolvimento; deixe desligado em produção)
# ENABLE_DOCS=true
